# ---- secrets & local machine state (never committed) ----
# Every keystore except the one release key, which is committed on purpose:
# it is public by design and only ever signs Sippy releases (signing/README.md).
*.jks
!sippy/android/signing/sippy-release.jks
*.keystore
*.b64
keystore.properties
!sippy/android/signing/signing.properties
local.properties
.env*
# the website's committed default base path is the one exception
!sippy/site/.env

# ---- IDE / OS ----
.idea/
*.iml
.DS_Store

# ---- Gradle / Android build output ----
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_

# Android release artifacts staged by CI (never committed)
sippy/android/dist/

# Staged by the deploy workflow (built site only, never committed)
sippy/site/public/releases/
