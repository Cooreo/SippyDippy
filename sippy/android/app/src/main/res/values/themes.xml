<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the colour system; the platform theme only supplies the
         window background, so the first frame matches the app instead of a
         white flash. -->
    <style name="Theme.Sippy" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sippy_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Round 8, B8: the platform splash, in the backdrop's dark blue, with the
         droplet mark. postSplashScreenTheme hands over to Theme.Sippy and the
         Compose intro starts from this exact colour. -->
    <style name="Theme.Sippy.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sippy_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Sippy</item>
    </style>
</resources>
